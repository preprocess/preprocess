{
  "name": "@preprocess/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema, migrations, the tenant data layer and the audit chain.",
  "author": "Preprocess, Inc.",
  "license": "Elastic-2.0",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./audit": "./src/audit.ts",
    "./ids": "./src/ids.ts",
