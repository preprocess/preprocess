{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ]
}
