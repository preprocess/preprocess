# Deploy inputs for one stage. Copy to .env.staging, .env.production or
# .env.preview (all ignored by Git) and pass it with --env-file, or export the
# same names in CI. Never commit a filled-in copy.

# Cloudflare API access for the deploy and for Alchemy's state store.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The region every resource of the stage runs in, a key of
# infra/src/regions.ts (spec 16d: region is configuration).
PREPROCESS_REGION=

# PlanetScale service token and database. Previews and staging branch from
# the database's main (pr-<number> and staging); production migrates the
# default branch of its own database.
PLANETSCALE_API_TOKEN_ID=
PLANETSCALE_API_TOKEN=
PLANETSCALE_ORGANIZATION=
PLANETSCALE_DATABASE=

# Production only: the database's current cluster size (for example PS_10),
# so the deploy never resizes it, and the app's hostname. Without APP_DOMAIN
# the app is served on workers.dev.
PLANETSCALE_CLUSTER_SIZE=
APP_DOMAIN=

# apps/api Worker. EMAIL_FROM is the invitation sender, on a domain set up for
# Cloudflare Email Sending. BETTER_AUTH_SECRET is 32 random bytes in base64;
# AUDIT_SIGNING_KEY is an Ed25519 private key, PKCS #8 DER in base64, named by
# AUDIT_SIGNING_KEY_ID (doc 02). The secrets master key is generated by the
# stack into the Secrets Store; nothing to set.
EMAIL_FROM=
AUDIT_SIGNING_KEY_ID=
BETTER_AUTH_SECRET=
AUDIT_SIGNING_KEY=

# Model service for the API and the runtime. Unset deploys and uses the stub.
MODEL_SERVICE_URL=
MODEL_SERVICE_KEY=
