# Deploy inputs for one stage. Copy to .env.staging or .env.preview (all ignored by Git) and pass it with --env-file, or export the
# same names in CI. Never commit a filled-in copy.

# Cloudflare API access for the deploy and for Alchemy's state store.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The region every resource of the stage runs in, a key of
# infra/src/regions.ts (spec 16d: region is configuration).
PREPROCESS_REGION=

# apps/app Worker secrets (WorkOS AuthKit). Required on staging, optional on
# pr-<number> previews.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=

# Preview stages: PlanetScale service token and the database each pr-<number>
# stage branches from.
PLANETSCALE_API_TOKEN_ID=
PLANETSCALE_API_TOKEN=
PLANETSCALE_ORGANIZATION=
PLANETSCALE_DATABASE=

# apps/api Worker (preview stages today). EMAIL_FROM is the invitation sender,
# on a domain set up for Cloudflare Email Sending. BETTER_AUTH_SECRET is 32
# random bytes in base64; AUDIT_SIGNING_KEY is an Ed25519 private key, PKCS #8
# DER in base64, named by AUDIT_SIGNING_KEY_ID (doc 02).
EMAIL_FROM=
AUDIT_SIGNING_KEY_ID=
BETTER_AUTH_SECRET=
AUDIT_SIGNING_KEY=

# Staging model service. Unset uses the API's stub.
MODEL_SERVICE_URL=
MODEL_SERVICE_KEY=
