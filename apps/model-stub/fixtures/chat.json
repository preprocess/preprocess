[
  {
    "name": "stock-check",
    "match": "Check stock for SKU A1",
    "turns": [
      {
        "toolCalls": [
          {
            "name": "lookup_stock",
            "arguments": {
              "sku": "A1"
            }
          }
        ]
      },
      {
        "toolCalls": [
          {
            "name": "carrier_status",
            "arguments": {
              "url": "https://example.com/track/A1"
            }
          }
        ]
      },
      {
        "toolCalls": [
          {
            "name": "find_contact",
            "arguments": {
              "q": "Acme buyer"
            }
          }
        ]
      },
      {
        "content": "SKU A1 checked. Results: {{results}}"
      }
    ]
  },
  {
    "name": "invoice-schema",
    "match": "Invoice 1042 from Acme",
    "turns": [
      {
        "toolCalls": [
          {
            "name": "decide",
            "arguments": {
              "path": "vendor",
              "prompt": "Which vendor sent this invoice?"
            }
          }
        ]
      },
      {
        "toolCalls": [
          {
            "name": "schema_answer",
            "arguments": {
              "answers": [
                {
                  "path": "vendor",
                  "value": "acme"
                },
                {
                  "path": "amount",
                  "value": 1285
                },
                {
                  "path": "currency",
                  "value": "USD"
                }
              ]
            }
          }
        ]
      },
      {
        "toolCalls": [
          {
            "name": "tag_group",
            "arguments": {
              "group": "accounts-payable",
              "message": "Please check the vendor on invoice 1042."
            }
          }
        ]
      },
      {
        "toolCalls": [
          {
            "name": "flag_vendor",
            "arguments": {
              "reason": "Vendor needs a check"
            }
          }
        ]
      },
      {
        "content": "Invoice 1042 filled in and handed to accounts payable."
      },
      {
        "toolCalls": [
          {
            "name": "schema_answer",
            "arguments": {
              "answers": [
                {
                  "path": "vendor",
                  "value": "acme"
                },
                {
                  "path": "currency",
                  "value": "EUR"
                }
              ]
            }
          }
        ]
      },
      {
        "content": "Rerun done: I still read Acme as the vendor."
      }
    ]
  },
  {
    "name": "memory-proposal",
    "match": "Order form for Globex renewal",
    "turns": [
      {
        "toolCalls": [
          {
            "name": "memory_propose",
            "arguments": {
              "text": "Globex renewal packs put the term dates in the order form, not the MSA.",
              "reason": "The MSA in this pack had no dates; the order form did."
            }
          }
        ]
      },
      {
        "content": "Read the term dates from the order form. {{results}}"
      }
    ]
  },
  {
    "name": "sandbox-sum",
    "match": "Add two and two in the sandbox",
    "turns": [
      {
        "toolCalls": [
          {
            "name": "sandbox_exec",
            "arguments": {
              "command": "python3 -c 'print(2 + 2)'"
            }
          }
        ]
      },
      {
        "content": "The sandbox said: {{results}}"
      }
    ]
  },
  {
    "name": "sandbox-smoke",
    "match": "Smoke test of the sandbox",
    "turns": [
      {
        "toolCalls": [
          {
            "name": "sandbox_exec",
            "arguments": {
              "command": "read up _ < /proc/uptime; t=$(cut -d' ' -f22 /proc/1/stat); hz=$(getconf CLK_TCK); now=$(date +%s%3N); s=$(awk -v n=\"$now\" -v u=\"$up\" -v t=\"$t\" -v hz=\"$hz\" 'BEGIN { printf \"%d\", n - (u - t / hz) * 1000 }'); echo \"sandbox ok now_ms=$now pid1_start_ms=$s\""
            }
          }
        ]
      },
      {
        "content": "The sandbox said: {{results}}"
      }
    ]
  },
  {
    "name": "sandbox-layer-smoke",
    "match": "Smoke test of a custom environment",
    "turns": [
      {
        "toolCalls": [
          {
            "name": "sandbox_exec",
            "arguments": {
              "command": "tree --version; cat /opt/smoke/layer.txt"
            }
          }
        ]
      },
      {
        "content": "The sandbox said: {{results}}"
      }
    ]
  }
]
