// stack in infra/, not this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preprocess-runtime-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "STAGE": "development",
    "MODEL_SERVICE_URL": "http://127.0.0.1:8790",
    "MODEL_SERVICE_KEY": "local",
  },
  "durable_objects": {
    "bindings": [{ "name": "CASE_RUNTIME", "class_name": "CaseRuntime" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CaseRuntime"] }],
  "r2_buckets": [
    { "binding": "RUNS", "bucket_name": "preprocess-runs-development" },
  ],
  "services": [
    {
      "binding": "LOCAL_NAMESPACE",
      "service": "preprocess-namespace-development",
    },
  ],
}
