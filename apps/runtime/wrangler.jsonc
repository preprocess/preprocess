// Generated by infra/scripts/wrangler-config.ts from infra/src/stages.ts.
// Do not edit: change infra/src/stages.ts and run
// `pnpm --filter @preprocess/infra wrangler:generate`. Deploys use the Alchemy
// stack in infra/, not this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preprocess-runtime-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "STAGE": "development",
    "MODEL_SERVICE_URL": "https://model-stub.preprocess.localhost",
    "MODEL_SERVICE_KEY": "development",
  },
  "durable_objects": {
    "bindings": [{ "name": "CASE_RUNTIME", "class_name": "CaseRuntime" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CaseRuntime"] }],
  "r2_buckets": [
    { "binding": "RUNS", "bucket_name": "preprocess-runs-development" },
    { "binding": "BUNDLES", "bucket_name": "preprocess-bundles-development" },
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    { "binding": "TAIL", "service": "preprocess-tail-development" },
    {
      "binding": "MCP_SERVICE",
      "service": "preprocess-api-development",
      "entrypoint": "McpService",
    },
    {
      "binding": "PLATFORM",
      "service": "preprocess-api-development",
      "entrypoint": "Platform",
    },
  ],
}
