{
  "name": "@preprocess/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:probe && pnpm build:staging && pnpm build:development",
    "build:development": "env -u CLOUDFLARE_ENV VITE_PREPROCESS_SHARED_UI_BUNDLE_PROBE=false vite build && EXPECT_PDF_WORKER=present EXPECT_PREVIEW_SIGN_IN=absent tsx scripts/verify-build.ts && wrangler deploy --dry-run --env=\"\" --config dist/server/wrangler.json --outdir dist/dry-run-development",
    "build:probe": "VITE_PREPROCESS_SHARED_UI_BUNDLE_PROBE=true vite build && EXPECT_PDF_WORKER=present tsx scripts/verify-build.ts",
    "build:staging": "CLOUDFLARE_ENV=staging VITE_PREPROCESS_SHARED_UI_BUNDLE_PROBE=false vite build && EXPECT_PDF_WORKER=present EXPECT_PREVIEW_SIGN_IN=absent tsx scripts/verify-build.ts && wrangler deploy --dry-run --env=\"\" --config dist/server/wrangler.json --outdir dist/dry-run-staging",
    "clean": "rm -rf .output .tanstack .wrangler coverage dist",
    "dev": "vite dev",
    "dev:preview": "PREPROCESS_PREVIEW=true vite dev --host 0.0.0.0 --port 5173 --strictPort",
    "dev:vite": "vite dev",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.54",
    "@base-ui/react": "catalog:",
    "@pierre/diffs": "^1.3.1",
    "@preprocess/ui": "catalog:",
    "@streamdown/code": "^1.1.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-virtual": "^3.14.22",
    "@workos-inc/node": "^10.9.0",
    "@workos/authkit-tanstack-react-start": "^0.11.0",
    "ai": "^7.0.48",
    "clsx": "catalog:",
    "docx-preview": "^0.4.0",
    "graphql": "catalog:",
    "graphql-request": "catalog:",
    "lottie-react": "^2.4.1",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "streamdown": "^2.5.0",
    "tailwind-merge": "catalog:",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
