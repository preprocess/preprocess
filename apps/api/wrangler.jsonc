{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preprocess-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "STAGE": "development",
    "MODEL_SERVICE_URL": "https://model-stub.preprocess.localhost",
    "MODEL_SERVICE_KEY": "development",
    "SECRETS_MASTER_KEY": "cHJlcHJvY2Vzcy1sb2NhbC1tYXN0ZXIta2V5LTMyYnk=",
