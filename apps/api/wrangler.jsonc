    "GITHUB_APP_SLUG": "preprocess-development",
    "GITHUB_CLIENT_ID": "Iv1.development",
    "GITHUB_API_URL": "http://127.0.0.1:8791",
    "GITHUB_URL": "http://127.0.0.1:8791",
    "SUPPORT_EMAIL_FROM": "Preprocess Support <support@preprocess.localhost>",
    "SUPPORT_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "SUPPORT_TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "local-app",
      "localConnectionString": "postgresql://preprocess_app:preprocess_app@127.0.0.1:5432/preprocess_development",
    },
    {
      "binding": "DB_SYSTEM",
      "id": "local-system",
      "localConnectionString": "postgresql://preprocess_system:preprocess_system@127.0.0.1:5432/preprocess_development",
    },
  ],
  "triggers": { "crons": ["20 0 * * *", "* * * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" },
      { "name": "BUILDS", "class_name": "BuildQueue" },
      { "name": "SCHEDULER", "class_name": "Scheduler" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Counter",
        "BuildQueue",
        "Scheduler",
        "RateLimiter",
      ],
    },
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "preprocess-jobs-development" },
      { "binding": "CASES", "queue": "preprocess-cases-development" },
      { "binding": "WEBHOOKS", "queue": "preprocess-webhooks-development" },
      { "binding": "EMAILS", "queue": "preprocess-emails-development" },
      { "binding": "LOGS", "queue": "preprocess-logs-development" },
    ],
    "consumers": [
      { "queue": "preprocess-jobs-development", "max_batch_timeout": 1 },
      { "queue": "preprocess-cases-development", "max_batch_timeout": 1 },
      {
        "queue": "preprocess-webhooks-development",
        "max_batch_timeout": 1,
        "max_retries": 20,
      },
      { "queue": "preprocess-emails-development", "max_batch_timeout": 1 },
      {
        "queue": "preprocess-logs-development",
        "max_batch_timeout": 1,
        "max_batch_size": 100,
      },
    ],
  },
  "kv_namespaces": [
    { "binding": "EMAILS_SENT", "id": "preprocess-emails-sent-development" },
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "preprocess-files-development" },
    { "binding": "AUDIT", "bucket_name": "preprocess-audit-development" },
    { "binding": "LOG_BUCKET", "bucket_name": "preprocess-logs-development" },
  ],
  "services": [
    { "binding": "RUNTIME", "service": "preprocess-runtime-development" },
    {
      "binding": "BUILDER",
      "service": "preprocess-builder-development",
      "entrypoint": "Builder",
    },
    { "binding": "PDF_RENDER", "service": "preprocess-pdf-render-development" },
  ],
}
