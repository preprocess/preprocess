// stack in infra/, not this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preprocess-api-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "STAGE": "development",
    "USER_WORKER": "hello",
    "MODEL_SERVICE_URL": "https://model-stub.preprocess.localhost",
    "MODEL_SERVICE_KEY": "development",
    "SECRETS_MASTER_KEY": "cHJlcHJvY2Vzcy1sb2NhbC1tYXN0ZXIta2V5LTMyYnk=",
    "APP_URL": "https://app.preprocess.localhost",
    "EMAIL_FROM": "Preprocess <invitations@preprocess.localhost>",
    "AUDIT_SIGNING_KEY_ID": "audit-ed25519-development",
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "local-app",
      "localConnectionString": "postgresql://preprocess_app:preprocess_app@127.0.0.1:5432/preprocess_development",
    },
    {
      "binding": "DB_SYSTEM",
      "id": "local-system",
      "localConnectionString": "postgresql://preprocess_system:preprocess_system@127.0.0.1:5432/preprocess_development",
    },
  ],
  "triggers": { "crons": ["20 0 * * *", "* * * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "preprocess-jobs-development" },
      { "binding": "CASES", "queue": "preprocess-cases-development" },
      {
        "binding": "SECRET_SYNC",
        "queue": "preprocess-secret-sync-development",
      },
    ],
    "consumers": [
      { "queue": "preprocess-jobs-development", "max_batch_timeout": 1 },
      { "queue": "preprocess-secret-sync-development", "max_batch_timeout": 1 },
      { "queue": "preprocess-cases-development", "max_batch_timeout": 1 },
    ],
  },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "preprocess-files-development" },
    { "binding": "AUDIT", "bucket_name": "preprocess-audit-development" },
  ],
  "services": [
    { "binding": "LOCAL_USER_WORKER", "service": "hello" },
    { "binding": "RUNTIME", "service": "preprocess-runtime-development" },
    {
      "binding": "LOCAL_NAMESPACE",
      "service": "preprocess-namespace-development",
      "entrypoint": "Namespace",
    },
  ],
}
