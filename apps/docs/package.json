{
  "name": "@preprocess/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "openapi": "pnpm --filter @preprocess/api openapi \"$PWD/openapi.json\"",
    "dev": "vite dev",
    "build": "pnpm openapi && vite build && wrangler deploy --dry-run --env=\"\" --config dist/server/wrangler.json --outdir dist/dry-run",
    "clean": "rm -rf .output .source .tanstack .wrangler dist openapi.json",
    "lint": "eslint .",
    "typecheck": "pnpm openapi && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@preprocess/cli": "workspace:*",
    "@preprocess/logs": "workspace:*",
    "@preprocess/ui": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-openapi": "12.6.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.7",
    "motion": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
